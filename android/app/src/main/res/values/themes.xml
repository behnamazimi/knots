<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Knots" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper_background</item>
        <item name="android:statusBarColor">@color/paper_background</item>
        <item name="android:navigationBarColor">@color/paper_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Knots.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/paper_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#F9F1E4</item>
        <item name="android:windowSplashScreenBackground">@color/paper_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">#F9F1E4</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="postSplashScreenTheme">@style/Theme.Knots</item>
    </style>
</resources>
