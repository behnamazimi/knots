{
  "name": "knots-made-easy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router typegen && tsc --noEmit && react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "preview": "wrangler pages dev",
    "deploy:pages": "pnpm build && wrangler pages deploy --branch main",
    "deploy:pages:preview": "pnpm build && wrangler pages deploy --branch preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "thumbs": "node tools/thumbs.mjs",
    "baked": "vite tools --port 5178",
    "film": "node tools/film.mjs"
  },
  "dependencies": {
    "isbot": "^5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "isbot": "^5.2.2",
    "jsdom": "^31.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.22"
  }
}
